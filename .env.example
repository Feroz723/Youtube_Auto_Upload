# ──────────────────────────────────────────────
# Google Drive
# ──────────────────────────────────────────────
# Folder ID for the "Videos" folder (pending uploads)
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=

# Folder ID for the "Uploaded" folder (completed uploads)
GOOGLE_DRIVE_UPLOADED_FOLDER_ID=

# ──────────────────────────────────────────────
# Google Sheets
# ──────────────────────────────────────────────
# Google Sheet ID for metadata tracking
GOOGLE_SHEET_ID=

# Worksheet (tab) name containing the metadata (e.g., "Sheet1" or "Videos")
GOOGLE_SHEET_WORKSHEET=

# ──────────────────────────────────────────────
# YouTube
# ──────────────────────────────────────────────
# YouTube channel category ID (default: 24 = Entertainment)
YOUTUBE_CATEGORY_ID=24

# Privacy status for uploaded videos: public, unlisted, or private (default: public)
YOUTUBE_PRIVACY_STATUS=public

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
